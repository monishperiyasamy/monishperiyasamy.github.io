import React, { useEffect, useState } from "react";
import { useParams, useNavigate } from "react-router-dom";
import axios from "axios";
import Button from "../components/Button";
import AddUserForm from "../components/AddUserForm";
import "../styles/DashboardWithProjects.css";

interface Project {
  projectId: number;
  title: string;
  description: string;
}

interface Member {
  userId: number;
  userName: string;
  email: string;
  role: string;
}

export default function ProjectDetails() {
  const { id } = useParams();
  const [project, setProject] = useState<Project | null>(null);
  const [members, setMembers] = useState<Member[]>([]);
  const [showAddUserForm, setShowAddUserForm] = useState(false);
  const token = localStorage.getItem("token");
  const role = localStorage.getItem("role");
  const navigate = useNavigate();

  useEffect(() => {
    const fetchDetails = async () => {
      try {
        const projRes = await axios.get(`http://localhost:3001/project/${id}`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        setProject(projRes.data.body[0]);

        const memberRes = await axios.get(
          `http://localhost:3001/project/${id}/members`,
          {
            headers: { Authorization: `Bearer ${token}` },
          }
        );
        setMembers(memberRes.data.members);
      } catch (err) {
        console.error("Error loading project details:", err);
      }
    };
    fetchDetails();
  }, [id, token]);

  const handleAddUser = async (userId: number, userRole: string) => {
    try {
      await axios.post(
        `http://localhost:3001/project/${id}/addUser`,
        { userId, role: userRole },
        { headers: { Authorization: `Bearer ${token}` } }
      );
      alert("User added!");
    } catch (err) {
      console.error("Error adding user:", err);
    }
  };

  const handleDeleteProject = async () => {
    try {
      await axios.delete(`http://localhost:3001/project/${id}`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      alert("Project deleted!");
      navigate("/dashboard");
    } catch (err) {
      console.error("Error deleting project:", err);
    }
  };

  if (!project) return <p>Loading project...</p>;

  return (
    <div className="dashboard-container">
      <h2>{project.title}</h2>
      <p>{project.description}</p>

      {role === "ADMIN" && (
        <>
          <Button label="Add User" onClick={() => setShowAddUserForm(!showAddUserForm)} />
          {showAddUserForm && (
            <AddUserForm
              projectId={project.projectId}
              onSubmit={handleAddUser}
            />
          )}
          <Button label="Delete Project" onClick={handleDeleteProject} />
        </>
      )}

      <h3>Project Members</h3>
      {members.length > 0 ? (
        <ul>
          {members.map((member) => (
            <li key={member.userId}>
              {member.userName} ({member.email}) — <strong>{member.role}</strong>
            </li>
          ))}
        </ul>
      ) : (
        <p>No members assigned to this project yet.</p>
      )}
    </div>
  );
}




import { useState } from "react";
import "../styles/AddUserForm.css";

interface AddUserFormProps {
  projectId: number;
  onSubmit: (userId: number, role: string) => void;
}

export default function AddUserForm({ projectId, onSubmit }: AddUserFormProps) {
  const [userId, setUserId] = useState<number>(0);
  const [role, setRole] = useState<string>("");

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    onSubmit(userId, role);
    setUserId(0);
    setRole("");
  };

  return (
    <form className="add-user-form" onSubmit={handleSubmit}>
      <h4>Add User to Project {projectId}</h4>
      <input
        type="number"
        value={userId}
        placeholder="User ID"
        onChange={(e) => setUserId(Number(e.target.value))}
      />
      <input
        type="text"
        value={role}
        placeholder="Role"
        onChange={(e) => setRole(e.target.value)}
      />
      <button type="submit" className="custom-btn">
        Add User
      </button>
    </form>
  );
}


.add-user-form {
  margin-top: 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.add-user-form input {
  padding: 8px;
  font-size: 14px;
}

