import React, { useEffect, useState } from "react";
import { useParams } from "react-router-dom";
import axios from "axios";
import "../styles/DashboardWithProjects.css"; // reuse container

interface Project {
  projectId: number;
  title: string;
  description: string;
}

interface Member {
  userId: number;
  userName: string;
  email: string;
  role: string; // added role
}

export default function ProjectDetails() {
  const { id } = useParams();
  const [project, setProject] = useState<Project | null>(null);
  const [members, setMembers] = useState<Member[]>([]);
  const token = localStorage.getItem("token");

  useEffect(() => {
    const fetchDetails = async () => {
      try {
        const projRes = await axios.get(`http://localhost:3001/project/${id}`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        setProject(projRes.data.body[0]);

        const memberRes = await axios.get(
          `http://localhost:3001/project/${id}/members`,
          {
            headers: { Authorization: `Bearer ${token}` },
          }
        );
        setMembers(memberRes.data.members);
      } catch (err) {
        console.error("Error loading project details:", err);
      }
    };
    fetchDetails();
  }, [id, token]);

  if (!project) return <p>Loading project...</p>;

  return (
    <div className="dashboard-container">
      <h2>{project.title}</h2>
      <p>{project.description}</p>

      <h3>Project Members</h3>
      {members.length > 0 ? (
        <ul>
          {members.map((member) => (
            <li key={member.userId}>
              {member.userName} ({member.email}) — <strong>{member.role}</strong>
            </li>
          ))}
        </ul>
      ) : (
        <p>No members assigned to this project yet.</p>
      )}
    </div>
  );
}

